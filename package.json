{
  "name": "ab-nextjs-hooks",
  "version": "0.1.4",
  "description": "🪝 A lightweight collection of server & client React hooks for abElements created by Abraham Ukachi, and optimized for Next.js applications 😎.",
  "type": "module",
  "main": "index.ts",
  "types": "types/index.d.ts",
  "homepage": "https://github.com/abraham-ukachi/ab-nextjs-hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham-ukachi/ab-nextjs-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/abraham-ukachi/ab-nextjs-hooks/issues"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "test": "vitest run",
    "check:publish": "node scripts/check-publish-deps.mjs",
    "prepublishOnly": "node scripts/check-publish-deps.mjs"
  },
  "keywords": [
    "react",
    "nextjs",
    "hooks",
    "abraham",
    "ukachi",
    "ab-nextjs-hooks",
    "ab-elements"
  ],
  "author": {
    "name": "Abraham Ukachi",
    "url": "https://github.com/abraham-ukachi",
    "email": "abraham.ukachi@laplateforme.io"
  },
  "license": "MIT",
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "happy-dom": "^20.14.5",
    "next": "16.3.4",
    "react": "^19",
    "react-dom": "^19",
    "standard-version": "^9.5.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "files": [
    "index.ts",
    "types",
    "helpers",
    "server",
    "useAb*.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.ts"
    },
    "./server/*": {
      "types": "./server/*.ts",
      "default": "./server/*.ts"
    },
    "./package.json": "./package.json",
    "./helpers/useAbToggle": {
      "types": "./helpers/useAbToggle.ts",
      "default": "./helpers/useAbToggle.ts"
    },
    "./helpers/*": {
      "types": "./helpers/*.ts",
      "default": "./helpers/*.ts"
    }
  }
}
